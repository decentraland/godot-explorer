class-definitions-order:
- tools
- classnames
- extends
- docstrings
- signals
- enums
- consts
- exports
- pubvars
- prvvars
- onreadypubvars
- onreadyprvvars
- staticvars
- others
class-load-variable-name: (([A-Z][a-z0-9]*)+|_?[a-z][a-z0-9]*(_[a-z0-9]+)*)
class-name: ([A-Z][a-z0-9]*)+
class-variable-name: _?[a-z][a-z0-9]*(_[a-z0-9]+)*
comparison-with-itself: null
constant-name: _?[A-Z][A-Z0-9]*(_[A-Z0-9]+)*
# --- Object-lifetime rules (dcl fork of gdtoolkit, gdtoolkit/linter/lifetime_checks.py) ---
# On the release template a GDScript method call on a freed node is a SIGSEGV, and
# an `await` is where references go stale. `lifetime-safe-types` lists the declared
# types that can never hold a node, on top of the built-ins and engine classes the
# rule already knows: every GDExtension class (Rust `Dcl*`, sentry) and the project's
# own RefCounted / Resource classes. Regenerate the extension part with
#   .bin/godot/godot4_bin --headless --path godot --script <fork>/gdtoolkit/linter/tools/generate_safe_types.gd
# and the project part from `class_name X extends <non-Node>` declarations.
lifetime-safe-types: '^(CocoaBreadcrumb|CocoaEvent|CocoaLog|CocoaMetric|DclAndroidPlugin|DclAvatarWireFormat|DclConfig|DclContentMappingAndUrl|DclEmoteGltf|DclEther|DclGlobalTime|DclHashing|DclIosPlugin|DclItemEntityDefinition|DclLocomotionSettings|DclLogHubLogger|DclParseDeepLink|DclPreviewMessage|DclRpcSenderGetTextureSize|DclRpcSenderTakeAndCompareSnapshotResponse|DclSceneEmoteData|DclSceneEntityDefinition|DclStoreKitPlugin|DclSwiftLibPlugin|DclUrls|DclUserProfile|DclVirtualCamera|DisabledEvent|DotnetBeforeSendProcessor|DotnetScopeObserver|NetworkInspectedRequest|ProfileService|Promise|PromiseError|RequestResponse|RequestResponseError|RuntimeConfig|RustHttpQueueRequester|ScreenshotProcessor|SentryAndroidOptions|SentryAttachment|SentryBadCode|SentryBreadcrumb|SentryEvent|SentryEventProcessor|SentryExperimental|SentryFeedback|SentryGodotLogger|SentryGodotLoggerOptions|SentryLog|SentryLogger|SentryLoggerLimits|SentryMetric|SentryMetrics|SentryOptions|SentrySDK|SentryScopeObserver|SentryTimestamp|SentryUnit|SentryUser|TextureEntry|ViewHierarchyProcessor|WearableManyResolved|ActionIcons|AnalyticsController|AudioSettings|AvatarAnimHelpers|AvatarBuildProfiler|AvatarEmoteController|AvatarExcludeIdMatcher|AvatarImpostorConfig|AvatarMeshAssembler|AvatarPoolPolicy|AvatarRendererHelper|BugReportCapture|BugReportCategories|BugReportService|CameraRigHelpers|CampaignResolution|ChatCommands|Chronometer|ConfigData|CornerConfiguration|DclUrn|DebugCollector|DeepLinkRouter|Destination|DestinationResolver|EmoteLoader|Emotes|Erc20|FeaturedDataProvider|GeneralSettings|GlyphMap|GraphicSettings|ImagePickerService|LocaleFormat|LocaleSettings|MarketplaceUrl|NameplateLayer|NamesRequest|Navigator|NftFrameStyleLoader|NodeGuard|NotificationOSWrapper|NotificationTextHelper|NotificationUtils|OpenSeaFetcher|PlaceholderManager|PlacesHelper|PreloadAssets|ProjectMainLoop|PromiseUtils|RewardCampaigns|SafeAreaMargins|SceneHelper|SceneLimits|SceneRendererInputHelper|SceneStatsCollector|SdkTouchControlsApplier|SentrySeeder|SentryUserFeedback|Snapshot|SocialHelper|SocialItemData|TextLayout|TextMarkup|TranslationKey|UnZip|WearableLoader|WearableRequest|WorldPermissionsHelper|WorldSecretPrompt)$'
disable:
  # Enabled once the current hits are fixed (audit after decentraland/godotengine#21).
  - node-reference-across-await
  - node-argument-across-await
  # Audit-only: `== null` on a lazily created child is legitimate, so this stays off in CI.
  - node-null-comparison
duplicated-load: null
enum-element-name: '[A-Z][A-Z0-9]*(_[A-Z0-9]+)*'
enum-name: ([A-Z][a-z0-9]*)+
excluded_directories: !!set
  .git: null
  .godot: null
  android: null
  addons: null
expression-not-assigned: null
function-argument-name: _?[a-z][a-z0-9]*(_[a-z0-9]+)*
function-arguments-number: 10
function-name: (_on_([A-Z][a-z0-9]*)+(_[a-z0-9]+)*|_?[a-z][a-z0-9]*(_[a-z0-9]+)*)
function-preload-variable-name: ([A-Z][a-z0-9]*)+
function-variable-name: '[a-z][a-z0-9]*(_[a-z0-9]+)*'
load-constant-name: (([A-Z][a-z0-9]*)+|_?[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)
loop-variable-name: _?[a-z][a-z0-9]*(_[a-z0-9]+)*
max-file-lines: 1900
max-line-length: 9999
max-public-methods: 45
max-returns: 10
mixed-tabs-and-spaces: null
no-elif-return: null
no-else-return: null
private-method-call: null
signal-name: '[a-z][a-z0-9]*(_[a-z0-9]+)*'
sub-class-name: _?([A-Z][a-z0-9]*)+
tab-characters: 1
trailing-whitespace: null
unnecessary-pass: null
unused-argument: null
