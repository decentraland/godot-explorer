[sub_resource type="AnimationNodeAnimation" id="AnimationNodeAnimation_t3sgi"]
animation = &"loco/Walk"

[sub_resource type="AnimationNodeAnimation" id="AnimationNodeAnimation_6hma3"]
animation = &"loco/Jog"

[sub_resource type="AnimationNodeAnimation" id="AnimationNodeAnimation_mbjp4"]
