[sub_resource type="Shader" id="Shader_circle"]
code = "shader_type canvas_item;

// Masks the profile texture to a centered circle so square avatar snapshots don't show their
// corners outside the round frame (clip_children clips to the rect, not the rounded stylebox).
void fragment() {
	float d = distance(UV, vec2(0.5));
	COLOR.a *= 1.0 - smoothstep(0.5 - fwidth(d), 0.5, d);
}"

