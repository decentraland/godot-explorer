[node name="SceneUIContainer" type="Control" parent="UI" unique_id=1950684600]
unique_name_in_owner = true
editor_description = "Single container for all per-scene SDK UI (built at runtime under 'scenes_ui'). INPUT LAYERING: Godot picks GUI input by tree order and IGNORES z_index — scanning siblings from last child to first, the first mouse_filter=STOP control under the point wins. So UI siblings AFTER this node (shown BELOW it in the Scene tree) receive input before scene UI, while siblings BEFORE it (shown ABOVE) are blocked by scene UI wherever it has a STOP control. Keep movement/camera catch-areas (joystick, MobileCameraInput) before this node, and interactive app UI (HUD panels, navbar, menus) after it."
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="SafeAreaHud" type="SafeMarginContainer" parent="UI" unique_id=1210894567]
unique_name_in_owner = true
editor_description = "Safe-area frame for the interactive HUD (navbar, chat, navbar panels, emotes). Sits AFTER SceneUIContainer so it wins input over scene UI. Shares hud_margins.tres. The fullscreen Control_Menu draws opaque over the navbar (nothing hides it in code), so they never visually overlap."
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
margin_profile = ExtResource("34_hudmg")
symmetric_horizontal = true

[node name="InteractableHUD" type="Control" parent="UI/SafeAreaHud" unique_id=1898741314]
unique_name_in_owner = true
editor_description = "The hideable HUD content group (chat, navbar panels, emotes, navbar). Hide-UI hides THIS node, not the whole SafeAreaHud, so the sibling Show-UI button survives and children keep their own visibility state."
layout_mode = 2
mouse_filter = 2

