[node name="HBoxContainer" type="HBoxContainer" parent="Button_Google" unique_id=1841153230]
editor_description = "Centres the brand icon and the label as one group. The gap is `separation`, not padding baked into the button text: the label is a translation key, so its width changes per locale and any spaces would re-centre with it. The icon stays a TextureRect rather than the Button's `icon` slot because the theme modulates that slot (SnowButton/colors/icon_disabled_color) and these are brand marks that must not be recoloured. Children are mouse_filter=IGNORE so clicks reach the Button."
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 10
alignment = 1

