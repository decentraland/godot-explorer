// Project-wide settings. The Godot engine is optional: scripts/sync-godot-ios.sh writes
// ../Godot/godot.xcconfig (device SDK only); without it the app builds with the JS mock bridge.
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// The Swift bindings of dcl_host call into libdclgodot, which only the Godot build links.
EXCLUDED_SOURCE_FILE_NAMES = DclHostFfi.swift

#include? "../Godot/godot.xcconfig"
#include? "../Version.generated.xcconfig"
