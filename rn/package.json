    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "@types/react-test-renderer": "19.3.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "playwright-core": "1.49.0",
    "prettier": "2.8.8",
    "react-dom": "19.2.3",
    "react-native-web": "0.21.4",
    "react-test-renderer": "19.2.3",
    "reg-cli": "0.18.10",
