{
  "name": "DclRn",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "android": "react-native run-android --main-activity com.godot.game.GodotAppLauncher",
    "android:no-godot": "DCL_NO_GODOT=1 react-native run-android --main-activity com.godot.game.GodotAppLauncher --extra-params -PdclNoGodot=true",
    "ios": "react-native run-ios",
    "expo": "expo start",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "gallery:ids": "GALLERY_WRITE_IDS=1 jest gallery-coverage",
    "emulator:figma": "scripts/emulator-size.sh figma",
    "emulator:reset": "scripts/emulator-size.sh reset",
    "ubrn:generate": "node ./scripts/ubrn-generate.mjs"
  },
  "dependencies": {
    "@dcl/ui-native": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "1.16.3",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native/new-app-screen": "0.86.3",
    "@reown/appkit-core-react-native": "2.0.6",
    "@reown/appkit-ethers-react-native": "2.0.6",
    "@reown/appkit-react-native": "2.0.6",
    "@sentry/react-native": "8.30.0",
    "@ubjs/core": "0.31.0-6",
    "@walletconnect/react-native-compat": "2.21.10",
    "@walletconnect/utils": "2.21.10",
    "dcl-core": "file:./modules/dcl-core",
    "expo": "57.0.27",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "1.11.0",
    "react-native-inappbrowser-reborn": "3.7.1",
    "react-native-orientation-locker": "1.7.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.5",
    "uniffi-bindgen-react-native": "0.31.0-6",
    "valtio": "2.1.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
